# =====================================================================
# Smart Greenhouse IoT Dashboard — environment configuration template
# =====================================================================
# Copy this file to `.env` (which is gitignored) and adjust as needed.
# All values below are safe lab defaults.

# ---------------------------------------------------------------------
# Backend (FastAPI)
# ---------------------------------------------------------------------

# Host and port the FastAPI app listens on.
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Path to the SQLite database file (relative to backend working dir).
# Use ":memory:" for ephemeral in-memory storage (useful for tests).
DATABASE_URL=sqlite:///./data/greenhouse.db

# Optional API key. If set, write endpoints (POST/PUT) require the
# header `X-API-Key: <value>`. Read endpoints remain open for demo use.
# Leave empty in dev to allow unauthenticated writes.
GREENHOUSE_API_KEY=

# CORS — comma-separated list of allowed origins for the dashboard.
# Wildcards are intentionally disallowed.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limiting (requests per second per client IP) on ingest endpoint.
INGEST_RATE_LIMIT_PER_SECOND=50

# Max number of concurrent WebSocket clients.
MAX_WS_CONNECTIONS=100

# Log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Log format: "json" for structured logs, "text" for human-readable.
LOG_FORMAT=json

# ---------------------------------------------------------------------
# Simulator
# ---------------------------------------------------------------------

# URL the simulator posts readings to. In Docker Compose this becomes
# http://backend:8000; locally it is http://localhost:8000.
SIMULATOR_BACKEND_URL=http://localhost:8000

# Interval between simulated readings, in seconds.
SIMULATOR_INTERVAL_SECONDS=5

# Sensor identifier embedded in every payload.
SIMULATOR_SENSOR_ID=esp32-sim-01

# Optional API key for the simulator (must match GREENHOUSE_API_KEY).
SIMULATOR_API_KEY=

# Hard limits — both default to 0 ("run forever"). Set either to stop.
SIMULATOR_MAX_ITERATIONS=0
SIMULATOR_MAX_DURATION_SECONDS=0

# HTTP timeout (seconds) for each individual POST.
SIMULATOR_REQUEST_TIMEOUT_SECONDS=5

# Exponential backoff bounds applied after any failed tick.
SIMULATOR_INITIAL_BACKOFF_SECONDS=1
SIMULATOR_MAX_BACKOFF_SECONDS=10

# Optional seed for deterministic random walks (useful for demos).
# Leave empty for a non-deterministic run.
# SIMULATOR_SEED=42

# ---------------------------------------------------------------------
# Frontend (Vite)
# ---------------------------------------------------------------------
# These variables are read by Vite at build time and must be prefixed
# with VITE_ to be exposed to the browser.

# Base URL of the backend REST API.
VITE_API_BASE_URL=http://localhost:8000

# WebSocket URL for live updates.
VITE_WS_URL=ws://localhost:8000/ws
