// =============================================================================
// Smart Greenhouse — firmware secrets template
// =============================================================================
// Copy this file to `secrets.h` in the same directory and fill in your values.
// `secrets.h` is gitignored — do not commit your real credentials.

#pragma once

// Wi-Fi credentials. Must reach the backend host on the same network.
#define WIFI_SSID      "your-network"
#define WIFI_PASSWORD  "your-password"

// URL the firmware POSTs readings to. Must be reachable from the ESP32.
// Use the host's LAN IP — `localhost` will not work from the ESP32.
#define BACKEND_URL    "http://192.168.1.50:8000/api/readings"

// Optional API key. Leave empty if your backend has GREENHOUSE_API_KEY unset.
#define API_KEY        ""

// Identifier embedded in every payload (max 64 chars).
#define SENSOR_ID      "esp32-greenhouse-01"
